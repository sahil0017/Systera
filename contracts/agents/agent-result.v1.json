{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://systera.dev/contracts/agents/agent-result.v1.json",
  "title": "AgentResult v1.0",
  "description": "Result produced by a specialist agent for one AgentTaskEnvelope attempt. Stored as agent_tasks.result_json and passed to downstream tasks as dependency results.",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "run_id",
    "agent_type",
    "attempt",
    "status",
    "summary",
    "output",
    "usage",
    "completed_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "task_id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "format": "uuid" },
    "agent_type": { "type": "string" },
    "attempt": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["SUCCEEDED", "FAILED"] },
    "summary": { "type": "string", "minLength": 1 },
    "output": { "type": "object", "description": "Agent-specific structured output." },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim"],
        "properties": {
          "claim": { "type": "string" },
          "source": { "type": "string" }
        }
      }
    },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "error": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "model": { "type": "string" },
    "usage": {
      "type": "object",
      "required": ["model_calls", "tool_calls", "prompt_tokens", "completion_tokens", "cost_usd"],
      "properties": {
        "model_calls": { "type": "integer", "minimum": 0 },
        "tool_calls": { "type": "integer", "minimum": 0 },
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "completed_at": { "type": "string", "format": "date-time" }
  }
}
