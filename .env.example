# Control Plane API
SYSTERA_ENV=development
SYSTERA_HTTP_ADDR=:8080
SYSTERA_LOG_LEVEL=info
SYSTERA_SHUTDOWN_TIMEOUT=15s
# Apply pending migrations on API start (otherwise run `make migrate-up`).
SYSTERA_AUTO_MIGRATE=false
# Server-Sent Events: max lag if a NOTIFY is missed, and idle keep-alive interval.
SYSTERA_SSE_POLL_INTERVAL=2s
SYSTERA_SSE_HEARTBEAT_INTERVAL=15s

# Authentication (required): bearer JWTs are verified server-side with RS256.
# Configure exactly one verification source:
#   - SYSTERA_AUTH_JWKS_URL          your IdP's JWKS endpoint (production), or
#   - SYSTERA_AUTH_PUBLIC_KEY_FILE   a PEM public key file, or
#   - SYSTERA_AUTH_PUBLIC_KEY_PEM    the PEM inline.
# For local development `make keys` creates .secrets/auth_{private,public}.pem and the
# Makefile points SYSTERA_AUTH_PUBLIC_KEY_FILE / SYSTERA_AUTH_PRIVATE_KEY_FILE at them.
# SYSTERA_AUTH_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# SYSTERA_AUTH_PUBLIC_KEY_FILE=/absolute/path/to/auth_public.pem
# Used only by `systera-admin token` to sign local tokens:
# SYSTERA_AUTH_PRIVATE_KEY_FILE=/absolute/path/to/auth_private.pem
# SYSTERA_AUTH_KEY_ID=
SYSTERA_AUTH_ISSUER=systera
SYSTERA_AUTH_AUDIENCE=systera-control-plane

# PostgreSQL (System of Record + pgvector)
SYSTERA_POSTGRES_HOST=localhost
SYSTERA_POSTGRES_PORT=5432
SYSTERA_POSTGRES_DB=systera
SYSTERA_POSTGRES_USER=systera
SYSTERA_POSTGRES_PASSWORD=systera_dev_password
SYSTERA_POSTGRES_SSLMODE=disable
# Optional full URL; overrides the discrete settings above.
# SYSTERA_DATABASE_URL=postgres://systera:pass@localhost:5432/systera?sslmode=disable

# NATS JetStream (Durable Event Backbone). The scheduler's outbox relay publishes every
# committed event to <prefix>.<event_type>, e.g. systera.events.task.succeeded.
SYSTERA_NATS_URL=nats://localhost:4222
SYSTERA_NATS_STREAM=SYSTERA_EVENTS
SYSTERA_NATS_SUBJECT_PREFIX=systera.events

# Scheduler (cmd/scheduler): outbox relay + expired-lease reclamation + budget starvation.
SYSTERA_SCHEDULER_HTTP_ADDR=:8081
SYSTERA_RELAY_INTERVAL=500ms
SYSTERA_RELAY_BATCH_SIZE=100
SYSTERA_RECLAIM_INTERVAL=5s

# Agent worker (cmd/worker-agent).
# SYSTERA_WORKER_ID=            # defaults to <hostname>-<pid>
SYSTERA_WORKER_AGENT_TYPES=requirements_analyst
SYSTERA_WORKER_HTTP_ADDR=:8082
SYSTERA_LEASE_TTL=60s           # heartbeats run every TTL/3
SYSTERA_WORKER_POLL_INTERVAL=1s

# Model Gateway. Supported SYSTERA_MODEL_PROVIDER presets:
#   - groq        (https://api.groq.com/openai/v1; free tier, ~30 RPM; uses SYSTERA_MODEL_API_KEY or GROQ_API_KEY)
#   - openrouter  (https://openrouter.ai/api/v1; :free models; uses SYSTERA_MODEL_API_KEY or OPENROUTER_API_KEY)
#   - huggingface (https://router.huggingface.co/v1; free credits; uses SYSTERA_MODEL_API_KEY or HF_TOKEN)
#   - openai      (any OpenAI-compatible /v1/chat/completions endpoint: Ollama, vLLM, Together...)
# On start the worker checks GET <base>/models and refuses to run a model the provider no
# longer serves; hosted presets refuse to start without an API key.
# USD per million tokens: every model an agent may use MUST be listed in SYSTERA_MODEL_PRICING
# (0 for free/local tiers) so per-task budgets remain enforceable.
SYSTERA_MODEL_PROVIDER=groq

# --- Preset 1: Groq (free tier, no card required, ~30 RPM; models: llama-3.3-70b-versatile, Qwen, DeepSeek R1 Distill) ---
SYSTERA_MODEL_BASE_URL=https://api.groq.com/openai/v1
SYSTERA_MODEL_API_KEY=
SYSTERA_MODEL_DEFAULT=llama-3.3-70b-versatile
SYSTERA_MODEL_PRICING={"llama-3.3-70b-versatile":{"input_per_mtok":0,"output_per_mtok":0}}

# --- Preset 2: OpenRouter (:free open-source models; models: meta-llama/llama-3.3-70b-instruct:free, mistralai/mistral-7b-instruct:free) ---
# SYSTERA_MODEL_PROVIDER=openrouter
# SYSTERA_MODEL_BASE_URL=https://openrouter.ai/api/v1
# SYSTERA_MODEL_API_KEY=
# The free lineup changes; list current ones with:
#   curl -s https://openrouter.ai/api/v1/models | jq -r '.data[].id | select(endswith(":free"))'
# SYSTERA_MODEL_DEFAULT=google/gemma-4-31b-it:free
# SYSTERA_MODEL_PRICING={"google/gemma-4-31b-it:free":{"input_per_mtok":0,"output_per_mtok":0}}

# --- Preset 3: Hugging Face Router (monthly free credits; routes to Together/DeepInfra) ---
# SYSTERA_MODEL_PROVIDER=huggingface
# SYSTERA_MODEL_BASE_URL=https://router.huggingface.co/v1
# SYSTERA_MODEL_API_KEY=
# SYSTERA_MODEL_DEFAULT=meta-llama/Llama-3.3-70B-Instruct
# SYSTERA_MODEL_PRICING={"meta-llama/Llama-3.3-70B-Instruct":{"input_per_mtok":0,"output_per_mtok":0}}

# --- Preset 4: Local Ollama ---
# SYSTERA_MODEL_PROVIDER=openai
# SYSTERA_MODEL_BASE_URL=http://localhost:11434/v1
# SYSTERA_MODEL_API_KEY=
# SYSTERA_MODEL_DEFAULT=llama3.2
# SYSTERA_MODEL_PRICING={"llama3.2":{"input_per_mtok":0,"output_per_mtok":0}}

SYSTERA_MODEL_TIMEOUT=2m
# SYSTERA_MODEL_TEMPERATURE=0.2

# Redis (Transient Cache & Rate Limiting)
SYSTERA_REDIS_ADDR=localhost:6379

# Object Storage (S3-Compatible / MinIO)
SYSTERA_S3_ENDPOINT=http://localhost:9000
SYSTERA_S3_REGION=us-east-1
SYSTERA_S3_BUCKET=systera-artifacts
SYSTERA_S3_ACCESS_KEY=systera_minio
SYSTERA_S3_SECRET_KEY=systera_minio_secret

# Observability (OpenTelemetry)
OTEL_SERVICE_NAME=systera-control-plane
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
