{
  "manifest_version": 3,
  "name": "Systera Engineering Lens",
  "version": "1.1.0",
  "description": "User-initiated, privacy-first investigation of a website's visible capabilities and a proposed architecture.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "storage", "sidePanel"],
  "optional_permissions": ["scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": { "default_title": "Open Engineering Lens" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
